# ── 비밀 정보 (절대 커밋 금지) ──
.env
.env.*
!.env.example

# ── 데이터: 용량이 크고 재생성 가능하므로 커밋하지 않는다 (.gitkeep만 유지) ──
data/raw/**
data/processed/**
data/db/**
data/vectordb/**
!data/**/
!data/**/.gitkeep
# data/labels(표본 검수 결과)는 작고 사람이 만든 결과라 커밋한다

# ── 산출물 중 자동 생성물 ──
outputs/figures/**
!outputs/figures/.gitkeep

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# ── Streamlit 로컬 비밀 설정 ──
.streamlit/secrets.toml

# ── OS / IDE ──
.DS_Store
Thumbs.db
.vscode/
.idea/
